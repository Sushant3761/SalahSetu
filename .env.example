# SalahSetu Environment Configuration Example
# Copy this file to .env and insert your API keys. NEVER commit actual API keys to the repository.

# LLM Provider Configuration ("gemini", "openai", "mock")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
